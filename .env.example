# Copy to .env and replace every value. How to generate each secret: docs/server/install.md
# ("Generating the secrets"). Random values: openssl rand -hex 32 (hex: safe inside URLs)

# Public domain of the platform (passkeys are bound to it, it can't change later
# without registering the passkeys again)
DOMAIN=tracking.example.com
APP_NAME=Car Tracking

# Database (TimescaleDB)
POSTGRES_DB=car_tracking
POSTGRES_USER=car_tracking
# openssl rand -hex 32 (it goes inside DATABASE_URL: no / + = characters)
POSTGRES_PASSWORD=change-me

# Master secret, at least 32 characters (openssl rand -hex 32): device keys and pairing
# codes are derived from it, TOTP secrets are encrypted with it. Changing it means reflashing
# every tracker and enrolling every authenticator app again. Keep a backup.
CRYPTO_MASTER_KEY=change-me-with-a-long-random-value

# --- Exposure: profile "traefik" (Let's Encrypt) or "tunnel" (Cloudflare)
ACME_EMAIL=admin@example.com
# letsencrypt = HTTP/TLS challenge (ports 80/443 open), letsencrypt-dns = DNS challenge
TRAEFIK_CERTRESOLVER=letsencrypt
ACME_DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=

# --- Data
RETENTION_DAYS=365
# Positions of the phones (people): kept for less time
PHONE_RETENTION_DAYS=30
SIM_BUDGET_MB=200
OFFLINE_AFTER_HOURS=9
# Days and hours of statistics, schedules of the areas, notifications and backups
TIMEZONE=Europe/Rome
LOG_LEVEL=info

# --- Android app: package and SHA-256 fingerprint of the signing certificate, comma
# separated (keytool -list -v -keystore <keystore>), for the passkeys in the app
ANDROID_PACKAGE=com.cartracking.app
ANDROID_CERT_SHA256=

# --- Backups (service "backup", always on): daily dump in ./volumes/backups
BACKUP_TIME=03:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Copy off the server, profile "offsite" (restic, encrypted): e.g.
# sftp:user@host:/backups/car-tracking, s3:s3.amazonaws.com/bucket, b2:bucket:car-tracking
RESTIC_REPOSITORY=
# openssl rand -hex 32. Keep it also outside the server (password manager): without it the
# copy can't be read
RESTIC_PASSWORD=
OFFSITE_TIME=04:30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# --- Optional
# Map tiles (OpenStreetMap by default, fair use: personal use only)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
# Cell geolocation for the points without GNSS fix, e.g. https://api.beacondb.net/v1/geolocate
# (the cell ids are sent to that service). Empty = disabled
CELL_GEOLOCATION_URL=
# Push notifications on Android: Firebase service account in ./secrets/fcm.json
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json
FCM_SERVICE_ACCOUNT_FILE=

# National average prices of the fuels (weekly CSV of the Italian Ministry, MASE), for
# the costs of the trips. Empty = disabled
FUEL_PRICES_URL=https://sisen.mase.gov.it/dgsaie/api/v1/weekly-prices/report/export?format=CSV&lang=it
# GitHub repository of the project (owner/name): firmware images and app versions from its
# latest release, checked every 6 hours. Empty = disabled. Token optional (rate limit)
GITHUB_REPO=
GITHUB_TOKEN=

# Backend from the release images instead of a local build: pin the major version, the
# minor and patch updates come with "docker compose pull" or Watchtower (profile autoupdate)
# BACKEND_IMAGE=ghcr.io/<owner>/<repository>:2
BACKEND_IMAGE=
WATCHTOWER_SCHEDULE=0 0 4 * * *
WATCHTOWER_NOTIFICATION_URL=
